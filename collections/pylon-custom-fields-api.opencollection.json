{
  "opencollection": "1.0.0",
  "info": {
    "name": "Pylon Accounts Custom Fields API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Custom Fields",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List custom fields",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.usepylon.com/custom-fields"
          },
          "docs": "List custom fields"
        },
        {
          "info": {
            "name": "Create a custom field",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.usepylon.com/custom-fields",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create a custom field"
        },
        {
          "info": {
            "name": "Get a custom field",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.usepylon.com/custom-fields/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Get a custom field"
        },
        {
          "info": {
            "name": "Update a custom field",
            "type": "http"
          },
          "http": {
            "method": "PATCH",
            "url": "https://api.usepylon.com/custom-fields/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Update a custom field"
        }
      ]
    }
  ],
  "bundled": true
}