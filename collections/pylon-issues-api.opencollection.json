          "info": {
            "name": "List issues",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.usepylon.com/issues",
            "params": [
              {
                "name": "start_time",
                "value": "",
                "type": "query"
              },
              {
                "name": "end_time",
                "value": "",
                "type": "query"
              },
              {
                "name": "cursor",
                "value": "",
                "type": "query"
              },
              {
                "name": "limit",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Returns a paginated list of issues within a time range. The window between start_time and end_time may not exceed 30 days."
        },
        {
          "info": {
            "name": "Create an issue",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.usepylon.com/issues",
