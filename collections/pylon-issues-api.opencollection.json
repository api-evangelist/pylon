          "http": {
            "method": "POST",
            "url": "https://api.usepylon.com/issues/:id/followers",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
