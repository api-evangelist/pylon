            "name": "Get an issue",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.usepylon.com/issues/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Fetch a single issue by ID or number."
        },
        {
          "info": {
            "name": "Update an issue",
            "type": "http"
